# Copie para .env (ignorado pelo Git) e defina uma senha forte local.
# Nunca commite o .env. A senha precisa ter 8+ caracteres com maiúscula, minúscula, número e símbolo.
MSSQL_SA_PASSWORD=
MSSQL_PORT=14330

# Connection string da API (variável de ambiente, sobrescreve appsettings):
# ConnectionStrings__FinTrack=Server=localhost,14330;Database=FinTrack;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True
